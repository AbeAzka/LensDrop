<Window x:Class="LensDrop.Views.PhotoEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LensDrop Studio — Editor Foto Non-Destruktif"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="700" Width="1060" MinHeight="580" MinWidth="860"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="STUDIO EDIT FOTO" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TxtFileName" Text="IMG_0001.JPG" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnReset" Content="Reset ke Asli" Background="#334155" Foreground="White" Padding="14,7" BorderThickness="0" Cursor="Hand" Click="BtnReset_Click">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN WORKSPACE -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- PREVIEW CANVAS -->
            <Border Grid.Column="0" Background="#020617" Margin="16" CornerRadius="12" BorderBrush="#1E293B" BorderThickness="1">
                <Grid>
                    <Image x:Name="ImgPreview" Stretch="Uniform" Margin="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Border x:Name="BadgeLoading" Background="#CC0F172A" CornerRadius="8" Padding="14,8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="Memproses pratinjau..." Foreground="White" FontSize="13"/>
                    </Border>
                </Grid>
            </Border>

            <!-- CONTROL PANEL -->
            <Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1,0,0,0" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- PRESET WARNA -->
                        <TextBlock Text="PRESET WARNA CEPAT" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,18">
                            <Button Content="Original" Tag="Original" Click="BtnPreset_Click" Margin="0,0,6,6" Padding="10,6" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                            <Button Content="Vivid" Tag="Vivid" Click="BtnPreset_Click" Margin="0,0,6,6" Padding="10,6" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                            <Button Content="B&amp;W Classic" Tag="BW" Click="BtnPreset_Click" Margin="0,0,6,6" Padding="10,6" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                            <Button Content="Cinematic" Tag="Cinematic" Click="BtnPreset_Click" Margin="0,0,6,6" Padding="10,6" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                            <Button Content="Bright Pop" Tag="Bright" Click="BtnPreset_Click" Margin="0,0,6,6" Padding="10,6" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        </WrapPanel>

                        <!-- TRANSFORMASI -->
                        <TextBlock Text="ROTASI &amp; ORIENTASI" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="↺ 90°" Click="BtnRotateLeft_Click" Margin="0,0,4,0" Padding="8,7" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                            <Button Grid.Column="1" Content="↻ 90°" Click="BtnRotateRight_Click" Margin="2,0" Padding="8,7" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                            <Button Grid.Column="2" Content="⇄ Flip H" Click="BtnFlipH_Click" Margin="4,0,0,0" Padding="8,7" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        </Grid>

                        <!-- EXPOSURE / BRIGHTNESS -->
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Kecerahan (Brightness)" FontSize="12.5" Foreground="#E2E8F0"/>
                            <TextBlock x:Name="TxtBrightnessVal" Text="0%" FontSize="12" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Slider x:Name="SliderBrightness" Minimum="-0.40" Maximum="0.40" Value="0" TickFrequency="0.05" ValueChanged="Slider_ValueChanged" Margin="0,0,0,14"/>

                        <!-- CONTRAST -->
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Kontras (Contrast)" FontSize="12.5" Foreground="#E2E8F0"/>
                            <TextBlock x:Name="TxtContrastVal" Text="100%" FontSize="12" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Slider x:Name="SliderContrast" Minimum="0.60" Maximum="1.60" Value="1.0" TickFrequency="0.05" ValueChanged="Slider_ValueChanged" Margin="0,0,0,14"/>

                        <!-- SATURATION -->
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Saturasi Warna" FontSize="12.5" Foreground="#E2E8F0"/>
                            <TextBlock x:Name="TxtSaturationVal" Text="100%" FontSize="12" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Slider x:Name="SliderSaturation" Minimum="0.0" Maximum="1.80" Value="1.0" TickFrequency="0.05" ValueChanged="Slider_ValueChanged" Margin="0,0,0,16"/>

                        <!-- KUALITAS EXPORT -->
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Kualitas Export JPEG" FontSize="12.5" Foreground="#E2E8F0"/>
                            <TextBlock x:Name="TxtQualityVal" Text="95%" FontSize="12" Foreground="#10B981" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Slider x:Name="SliderQuality" Minimum="70" Maximum="100" Value="95" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Slider_ValueChanged" Margin="0,0,0,12"/>

                        <Border Background="#0F172A" CornerRadius="8" Padding="10" Margin="0,8,0,0">
                            <TextBlock Text="Edit bersifat non-destruktif: perubahan akan diterapkan otomatis saat file di-export ke folder lokal &amp; Google Drive." FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="20,0">
            <Grid>
                <TextBlock x:Name="TxtTransformInfo" Text="Rotasi: 0° | Flip: Tidak" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Batal" Padding="16,8" Margin="0,0,10,0" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click"/>
                    <Button Content="✓ Terapkan Edit ke Antrean" Padding="18,8" Background="#2563EB" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
