<Window x:Class="LensDrop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pengaturan — LensDrop Studio"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="610" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgPrimaryBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Pengaturan Aplikasi" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Konfigurasi tampilan tema, akun Google, sumber folder lokal, dan kualitas foto." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
            <StackPanel>
                <!-- Section 0: Tampilan & Tema Aplikasi -->
                <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="TAMPILAN &amp; TEMA APLIKASI" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Mode Tema" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Pilih tema terang, gelap, atau ikuti sistem Windows" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <ComboBox x:Name="CmbThemeSetting"
                                      Grid.Column="1"
                                      Width="160"
                                      Height="30"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="CmbThemeSetting_SelectionChanged">
                                <ComboBoxItem Content="🖥 Ikuti Windows" Tag="System"/>
                                <ComboBoxItem Content="☀ Light Mode" Tag="Light"/>
                                <ComboBoxItem Content="🌙 Dark Mode" Tag="Dark"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 1: Akun & Sinkronisasi -->
                <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="AKUN GOOGLE &amp; SINKRONISASI" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkSettingAutoLogin" Content="Otomatis pulihkan login Google Drive saat aplikasi dibuka" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,7"/>
                        <CheckBox x:Name="ChkSettingAutoUpload" Content="Aktifkan unggah otomatis ke Google Drive secara default" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,7"/>
                        <TextBlock x:Name="TxtTokenLocation" Text="Lokasi Token: %AppData%\LensDrop\DriveTokens" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Section 2: Import Folder Lokal & Kamera -->
                <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="SUMBER FOLDER LOKAL &amp; KAMERA" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkSettingIncludeSubfolders" Content="Pindai sub-folder secara rekursif saat membuka folder lokal" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,7"/>
                        <CheckBox x:Name="ChkSettingCopyInsteadMove" Content="Salin file (Copy) dari folder lokal agar file asli di sumber tetap aman" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,7"/>
                        <CheckBox x:Name="ChkSettingAutoScanUsb" Content="Deteksi &amp; pindai otomatis saat kamera USB dicolokkan" Style="{StaticResource ModernCheckBoxStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Section 3: Editor & Kualitas Output -->
                <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="EDITOR FOTO &amp; PEMELIHARAAN" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8"/>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Kualitas Default Export JPEG:" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Slider x:Name="SliderDefaultJpegQuality" Width="150" Minimum="70" Maximum="100" Value="95" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="SliderDefaultJpegQuality_ValueChanged"/>
                                <TextBlock x:Name="TxtDefaultQualityVal" Text="95%" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" Width="38" TextAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnClearCache" Content="Bersihkan Cache Pratinjau" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="BtnClearCache_Click"/>
                            <Button x:Name="BtnResetAllPrefs" Content="Reset Pengaturan Default" Style="{StaticResource SecondaryButtonStyle}" Click="BtnResetAllPrefs_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Info Versi -->
                <TextBlock Text="LensDrop Studio v0.2.0 • Dikembangkan oleh Indodev Studio" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Batal" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="BtnCancel_Click"/>
            <Button Content="Simpan Pengaturan" Style="{StaticResource PrimaryButtonStyle}" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
