<Window x:Class="LensDrop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LensDrop Studio by Indodev Studio — Camera Ingest, Photo Editor, Sorter &amp; Google Drive"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="790" Width="1220" MinHeight="680" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="76"/>
        </Grid.RowDefinitions>

        <!-- TOP APP BAR WITH GOOGLE PROFILE -->
        <Border Grid.Row="0" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Identity -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
					<Image Source="pack://application:,,,/Assets/logo.png"
                           Width="32"
                           Height="32"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="LensDrop" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="5" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="STUDIO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Camera Ingest, Non-Destructive Photo Editor &amp; Auto-Sorter" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Google Account Profile & Auto-Login -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkAutoLoginDrive"
                              Content="Auto-login saat dibuka"
                              IsChecked="True"
                              Style="{StaticResource ModernCheckBoxStyle}"
                              Margin="0,0,14,0"
                              Checked="ChkAutoLoginDrive_Changed"
                              Unchecked="ChkAutoLoginDrive_Changed"/>

                    <!-- Profile Pill -->
                    <Border x:Name="BadgeDriveStatus"
                            Background="{StaticResource BgSubtleBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="6,4,14,4"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <!-- Avatar Circle -->
                            <Grid Width="30" Height="30" Margin="0,0,10,0">
                                <Ellipse x:Name="AvatarBg" Fill="#CBD5E1"/>
                                <TextBlock x:Name="TxtAvatarInitials" Text="G" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse x:Name="AvatarImageEllipse" Visibility="Collapsed">
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="BrushAvatarImage" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtProfileName" Text="Akun Google Belum Login" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TxtProfileEmail" Text="Klik Login Google untuk profil &amp; sync Drive" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnLoginDrive" Content="Login dengan Google" Style="{StaticResource PrimaryButtonStyle}" Click="BtnLoginDrive_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN WORKSPACE -->
        <Grid Grid.Row="1" Margin="24,16,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CARD 1: SOURCE KAMERA (USB & WI-FI) -->
            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!--<Border Background="{StaticResource PrimaryLightBrush}" Width="34" Height="34" CornerRadius="8" Margin="0,0,12,0">
                            <TextBlock Text="📷" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>-->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Sumber Kamera (USB MTP &amp; Wi-Fi PTP/IP)" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TxtCameraHint" Text="Deteksi otomatis via kabel USB atau sambungkan lewat IP Wi-Fi kamera" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="CmbCameras" Width="250" Style="{StaticResource ModernComboBoxStyle}" DisplayMemberPath="DisplayName" SelectionChanged="CmbCameras_SelectionChanged" Margin="0,0,8,0"/>
                        <Button x:Name="BtnRefreshCameras" Content="⟳ Scan Ulang" Style="{StaticResource SecondaryButtonStyle}" Click="BtnRefreshCameras_Click" Margin="0,0,12,0"/>

                        <Border Width="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,4,12,4"/>

                        <TextBox x:Name="TxtWifiIp" Width="140" Style="{StaticResource ModernTextBoxStyle}" ToolTip="Masukkan alamat IP Wi-Fi kamera (Contoh: 192.168.1.45)" Margin="0,0,8,0"/>
                        <Button x:Name="BtnAddWifiIp" Content="+ Konek Wi-Fi" Style="{StaticResource SecondaryButtonStyle}" Click="BtnAddWifiIp_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CARD 2: KONFIGURASI PENYIMPANAN, SORTIR OTOMATIS & CLOUD -->
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1.55*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Kolom Kiri: Folder Tujuan & Google Drive -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="1. LOKASI PENYIMPANAN &amp; CLOUD" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtOutputDir" Grid.Column="0" Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True" Margin="0,0,8,0"/>
                            <Button x:Name="BtnBrowseDir" Grid.Column="1" Content="Pilih Folder..." Style="{StaticResource SecondaryButtonStyle}" Click="BtnBrowseDir_Click"/>
                        </Grid>

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<CheckBox x:Name="ChkUploadDrive" Grid.Column="0" Content="Sync ke Drive:" IsChecked="True" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,8,0"/>
							<TextBox x:Name="TxtDriveRootFolder" Grid.Column="1" Text="LensDrop_Backup" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,8,0" TextChanged="TxtDriveRootFolder_TextChanged"/>
							<Button x:Name="BtnBrowseDriveFolder" Grid.Column="2" Content="Pilih Drive..." Style="{StaticResource SecondaryButtonStyle}" Click="BtnBrowseDriveFolder_Click"/>
						</Grid>
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" Background="{StaticResource BorderSubtleBrush}" HorizontalAlignment="Center"/>

                    <!-- Kolom Kanan: Aturan Sortir Otomatis -->
                    <StackPanel Grid.Column="2">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="2. ATURAN SORTIR MEDIA OTOMATIS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock x:Name="TxtFolderPreview" Text="Preview: ...\Images6-11-25" FontSize="11" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <WrapPanel Margin="0,0,0,8">
                            <CheckBox x:Name="ChkSeparateType" Content="Pisah Foto &amp; Video" IsChecked="True" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,14,4" Checked="SortRule_Changed" Unchecked="SortRule_Changed"/>
                            <CheckBox x:Name="ChkGroupDate" Content="Folder Tanggal (YYYY-MM-DD)" IsChecked="True" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,14,4" Checked="SortRule_Changed" Unchecked="SortRule_Changed"/>
                            <CheckBox x:Name="ChkGroupModel" Content="Folder Seri Kamera" IsChecked="False" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,14,4" Checked="SortRule_Changed" Unchecked="SortRule_Changed"/>
                            <CheckBox x:Name="ChkRenameTimestamp" Content="Prefix Tanggal di Nama File" IsChecked="False" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,4"/>
                        </WrapPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Sub-Folder Proyek / Event (Opsional):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtCustomEventFolder" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" ToolTip="Contoh: Wedding_Andi, Liburan_Bromo" TextChanged="TxtCustomEventFolder_TextChanged"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CARD 3: GALERI MEDIA, SORTIR TAMPILAN & EDITOR FOTO -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar Filter, Urutkan & Edit -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Pilih Semua" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" Click="BtnSelectAll_Click" Margin="0,0,6,0"/>
                                <Button Content="Batal Pilih" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" Click="BtnDeselectAll_Click" Margin="0,0,10,0"/>

                                <ComboBox x:Name="CmbFilterType" Width="135" Height="30" SelectedIndex="0" SelectionChanged="CmbFilterType_SelectionChanged" Margin="0,0,8,0">
                                    <ComboBoxItem Content="Semua Media"/>
                                    <ComboBoxItem Content="Hanya Foto"/>
                                    <ComboBoxItem Content="Hanya Video"/>
                                    <ComboBoxItem Content="Sudah Diedit"/>
                                </ComboBox>

                                <ComboBox x:Name="CmbSortOrder" Width="165" Height="30" SelectedIndex="0" SelectionChanged="CmbSortOrder_SelectionChanged" Margin="0,0,8,0">
                                    <ComboBoxItem Content="Urutkan: Nama (A-Z)"/>
                                    <ComboBoxItem Content="Urutkan: Nama (Z-A)"/>
                                    <ComboBoxItem Content="Urutkan: Ukuran Terbesar"/>
                                    <ComboBoxItem Content="Urutkan: Ukuran Terkecil"/>
                                    <ComboBoxItem Content="Urutkan: Tipe File"/>
                                </ComboBox>

                                <TextBox x:Name="TxtSearchMedia" Width="170" Height="30" Style="{StaticResource ModernTextBoxStyle}" ToolTip="Cari nama file..." TextChanged="TxtSearchMedia_TextChanged"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnEditSelectedPhoto" Content="✎ Edit Foto Terpilih" Style="{StaticResource PrimaryButtonStyle}" Padding="12,6" Click="BtnEditSelectedPhoto_Click" Margin="0,0,12,0"/>
                                <TextBlock x:Name="TxtSummaryStats" Text="0 file dipilih (0 MB)" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- DataGrid Media -->
                    <DataGrid x:Name="GridMedia" Grid.Row="1" AutoGenerateColumns="False" MouseDoubleClick="GridMedia_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Pilih" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="56"/>
                            <DataGridTextColumn Header="Nama File" Binding="{Binding FileName}" Width="*" IsReadOnly="True"/>

                            <DataGridTemplateColumn Header="Tipe" Width="88">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MediaType}" Value="Video">
                                                            <Setter Property="Background" Value="{StaticResource PurpleLightBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Extension}" FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MediaType}" Value="Video">
                                                                <Setter Property="Foreground" Value="{StaticResource PurpleTextBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Ukuran" Binding="{Binding FileSizeFormatted}" Width="95" IsReadOnly="True"/>

                            <!-- Kolom Status Edit Foto -->
                            <DataGridTemplateColumn Header="Edit Foto" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border CornerRadius="6" Padding="8,3" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource BgSubtleBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasPendingEdits}" Value="True">
                                                                <Setter Property="Background" Value="#FEF3C7"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding EditBadgeText}" FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasPendingEdits}" Value="True">
                                                                    <Setter Property="Foreground" Value="#B45309"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <Button Content="✎"
                                                    ToolTip="Edit foto ini"
                                                    Padding="7,2"
                                                    FontSize="11"
                                                    Cursor="Hand"
                                                    Background="{StaticResource PrimaryLightBrush}"
                                                    Foreground="{StaticResource PrimaryBrush}"
                                                    BorderThickness="0"
                                                    Click="BtnEditRowPhoto_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditableImage}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Status Transfer" Width="195">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="Medium">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusCategory}" Value="Processing">
                                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusCategory}" Value="Done">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusCategory}" Value="Error">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM ACTION & PROGRESS FOOTER -->
        <Border Grid.Row="2" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Grid Margin="0,0,0,6">
                        <TextBlock x:Name="TxtLog" Text="Siap. Hubungkan kamera Anda melalui USB atau Wi-Fi untuk mulai." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="TxtProgressPercent" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar x:Name="ProgressTotal" Height="7" Minimum="0" Maximum="100" Value="0" Background="{StaticResource BgPrimaryBrush}" Foreground="{StaticResource PrimaryBrush}" BorderThickness="0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnOpenOutputFolder" Content="Buka Folder Hasil" Style="{StaticResource SecondaryButtonStyle}" Padding="14,10" Margin="0,0,10,0" Click="BtnOpenOutputFolder_Click"/>
                    <Button x:Name="BtnStartProcess" Content="Mulai Export, Edit &amp; Upload" Style="{StaticResource SuccessButtonStyle}" Padding="20,11" FontSize="13.5" Click="BtnStartProcess_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
