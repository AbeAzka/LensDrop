<Window x:Class="LensDrop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LensDrop Studio — Camera &amp; Folder Ingest, Photo Editor, Sorter &amp; Google Drive"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="760" Width="1220" MinHeight="640" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgPrimaryBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- TOP APP BAR (COMPACT) -->
        <Border Grid.Row="0" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Identity -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/logo.png"
                           Width="32"
                           Height="32"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="LensDrop" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Border Background="{DynamicResource PrimaryLightBrush}" CornerRadius="4" Padding="6,1.5" Margin="7,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="STUDIO v0.2" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="By Indodev Studio" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Theme Switcher, Profile, Feedback & Settings -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                   
                    <CheckBox x:Name="ChkAutoLoginDrive"
                              Content="Auto-login"
                              IsChecked="True"
                              Style="{StaticResource ModernCheckBoxStyle}"
                              Margin="0,0,10,0"
                              Checked="ChkAutoLoginDrive_Changed"
                              Unchecked="ChkAutoLoginDrive_Changed"/>

                    <!-- Compact Profile Pill -->
                    <Border x:Name="BadgeDriveStatus"
                            Background="{DynamicResource BgSubtleBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="5,3,12,3"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="26" Height="26" Margin="0,0,8,0">
                                <Ellipse x:Name="AvatarBg" Fill="#CBD5E1"/>
                                <TextBlock x:Name="TxtAvatarInitials" Text="G" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse x:Name="AvatarImageEllipse" Visibility="Collapsed">
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="BrushAvatarImage" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtProfileName" Text="Akun Google Belum Login" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TxtProfileEmail" Text="Klik Login untuk sync Drive" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnLoginDrive" Content="Login Google" Height="30" Padding="12,0" Style="{StaticResource PrimaryButtonStyle}" Click="BtnLoginDrive_Click" Margin="0,0,6,0"/>
                    <Button x:Name="BtnFeedback" Content="💬" Width="32" Height="30" Padding="0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnFeedback_Click" Margin="0,0,6,0" ToolTip="Kirim saran atau laporan bug"/>
                    <Button x:Name="BtnSettings" Content="⚙" Width="32" Height="30" Padding="0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnSettings_Click" ToolTip="Pengaturan Aplikasi"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN WORKSPACE -->
        <Grid Grid.Row="1" Margin="16,12,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CARD 1: SOURCE MEDIA (COMPACT) -->
            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,10" Padding="12,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Sumber Media (Kamera USB / Wi-Fi atau Folder Lokal)" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="TxtCameraHint" Text="Deteksi kamera otomatis, sambung Wi-Fi, atau pilih folder foto/video di PC" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="CmbCameras"
                                  Width="225"
                                  Height="30"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  VerticalContentAlignment="Center"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="CmbCameras_SelectionChanged"
                                  Margin="0,0,6,0"/>
                        <Button x:Name="BtnRefreshCameras" Content="⟳ Scan" Height="30" Padding="10,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnRefreshCameras_Click" Margin="0,0,6,0" ToolTip="Scan ulang kamera USB"/>
                        <Button x:Name="BtnSelectSourceFolder" Content="📂 Folder Lokal" Height="30" Padding="12,0" Style="{StaticResource PrimaryButtonStyle}" Click="BtnSelectSourceFolder_Click" Margin="0,0,10,0" ToolTip="Sortir, edit &amp; upload foto dari folder PC"/>

                        <Border Width="1" Height="22" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,10,0"/>

                        <TextBox x:Name="TxtWifiIp" Width="125" Height="30" VerticalContentAlignment="Center" Style="{StaticResource ModernTextBoxStyle}" ToolTip="Alamat IP Wi-Fi kamera (Contoh: 192.168.1.45)" Margin="0,0,6,0"/>
                        <Button x:Name="BtnAddWifiIp" Content="+ Wi-Fi IP" Height="30" Padding="10,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnAddWifiIp_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CARD 2: PENYIMPANAN, SORTIR OTOMATIS & CLOUD (COMPACT) -->
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,10" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="1.6*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Kolom Kiri: Folder Tujuan & Google Drive -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="1. LOKASI PENYIMPANAN &amp; GOOGLE DRIVE" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,6"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtOutputDir" Grid.Column="0" Height="30" VerticalContentAlignment="Center" Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True" Margin="0,0,6,0"/>
                            <Button x:Name="BtnBrowseDir" Grid.Column="1" Content="Folder Output..." Height="30" Padding="10,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnBrowseDir_Click"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkUploadDrive" Grid.Column="0" Content="Sync Drive:" IsChecked="True" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,8,0" Checked="SortRule_Changed" Unchecked="SortRule_Changed"/>
                            <TextBox x:Name="TxtDriveRootFolder" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Text="LensDrop_Backup" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,6,0" TextChanged="TxtDriveRootFolder_TextChanged"/>
                            <Button x:Name="BtnBrowseDriveFolder" Grid.Column="2" Content="Pilih Drive..." Height="30" Padding="10,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnBrowseDriveFolder_Click"/>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderSubtleBrush}" HorizontalAlignment="Center"/>

                    <!-- Kolom Kanan: Aturan Sortir Otomatis -->
                    <StackPanel Grid.Column="2">
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="2. ATURAN SORTIR MEDIA OTOMATIS" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock x:Name="TxtFolderPreview" Text="Preview: ...\Images\2026-11-25" FontSize="10.5" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <WrapPanel Margin="0,0,0,6">
                            <CheckBox x:Name="ChkSeparateType" Content="Pisah Foto &amp; Video" IsChecked="True" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,12,2" Checked="SortRule_Changed" Unchecked="SortRule_Changed"/>
                            <CheckBox x:Name="ChkGroupDate" Content="Folder Tanggal (YYYY-MM-DD)" IsChecked="True" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,12,2" Checked="SortRule_Changed" Unchecked="SortRule_Changed"/>
                            <CheckBox x:Name="ChkGroupModel" Content="Folder Seri Kamera" IsChecked="False" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,12,2" Checked="SortRule_Changed" Unchecked="SortRule_Changed"/>
                            <CheckBox x:Name="ChkRenameTimestamp" Content="Prefix Tanggal File" IsChecked="False" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,2" Checked="SortRule_Changed" Unchecked="SortRule_Changed"/>
                        </WrapPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Sub-Folder Proyek / Event:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtCustomEventFolder" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Style="{StaticResource ModernTextBoxStyle}" ToolTip="Contoh: Wedding_Andi, Liburan_Bromo" TextChanged="TxtCustomEventFolder_TextChanged"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CARD 3: GALERI MEDIA, DROPDOWN FILTER & EDITOR -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar Compact -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="12,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Pilih Semua" Height="28" Style="{StaticResource SecondaryButtonStyle}" Padding="9,0" FontSize="11.5" Click="BtnSelectAll_Click" Margin="0,0,5,0"/>
                                <Button Content="Batal Pilih" Height="28" Style="{StaticResource SecondaryButtonStyle}" Padding="9,0" FontSize="11.5" Click="BtnDeselectAll_Click" Margin="0,0,8,0"/>

                                <Border Width="1" Height="20" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,8,0"/>

                                <!-- Dropdown Filter dengan Style Konsisten -->
                                <ComboBox x:Name="CmbFilterType"
                                          Width="135"
                                          Height="28"
                                          SelectedIndex="0"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          VerticalContentAlignment="Center"
                                          SelectionChanged="CmbFilterType_SelectionChanged"
                                          Margin="0,0,6,0">
                                    <ComboBoxItem Content="Semua Media"/>
                                    <ComboBoxItem Content="Hanya Foto"/>
                                    <ComboBoxItem Content="Hanya Video"/>
                                    <ComboBoxItem Content="Sudah Diedit"/>
                                </ComboBox>

                                <!-- Dropdown Sortir dengan Style Konsisten -->
                                <ComboBox x:Name="CmbSortOrder"
                                          Width="175"
                                          Height="28"
                                          SelectedIndex="0"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          VerticalContentAlignment="Center"
                                          SelectionChanged="CmbSortOrder_SelectionChanged"
                                          Margin="0,0,6,0">
                                    <ComboBoxItem Content="Urutkan: Nama (A-Z)"/>
                                    <ComboBoxItem Content="Urutkan: Nama (Z-A)"/>
                                    <ComboBoxItem Content="Urutkan: Ukuran Terbesar"/>
                                    <ComboBoxItem Content="Urutkan: Ukuran Terkecil"/>
                                    <ComboBoxItem Content="Urutkan: Tipe File"/>
                                </ComboBox>

                                <TextBox x:Name="TxtSearchMedia"
                                         Width="170"
                                         Height="28"
                                         VerticalContentAlignment="Center"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         ToolTip="Cari nama file..."
                                         TextChanged="TxtSearchMedia_TextChanged"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnEditSelectedPhoto" Content="✎ Edit Foto Terpilih" Height="28" Style="{StaticResource PrimaryButtonStyle}" Padding="11,0" FontSize="11.5" Click="BtnEditSelectedPhoto_Click" Margin="0,0,10,0"/>
                                <TextBlock x:Name="TxtSummaryStats" Text="0 file dipilih (0 MB)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- DataGrid Media -->
                    <DataGrid x:Name="GridMedia"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              RowHeight="34"
                              ColumnHeaderHeight="34"
                              Background="{DynamicResource BgSurfaceBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}"
                              MouseDoubleClick="GridMedia_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Pilih" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                            <DataGridTextColumn Header="Nama File" Binding="{Binding FileName}" Width="*" IsReadOnly="True"/>

                            <DataGridTemplateColumn Header="Tipe" Width="82">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="5" Padding="7,2" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MediaType}" Value="Video">
                                                            <Setter Property="Background" Value="{DynamicResource PurpleLightBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Extension}" FontSize="10.5" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MediaType}" Value="Video">
                                                                <Setter Property="Foreground" Value="{DynamicResource PurpleTextBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Ukuran" Binding="{Binding FileSizeFormatted}" Width="90" IsReadOnly="True"/>

                            <!-- Kolom Status Edit Foto -->
                            <DataGridTemplateColumn Header="Edit Foto" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border CornerRadius="5" Padding="7,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource BgSubtleBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasPendingEdits}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource WarningLightBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding EditBadgeText}" FontSize="10.5" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasPendingEdits}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <Button Content="✎"
                                                    ToolTip="Edit foto ini"
                                                    Padding="6,1.5"
                                                    FontSize="10.5"
                                                    Cursor="Hand"
                                                    Background="{DynamicResource PrimaryLightBrush}"
                                                    Foreground="{DynamicResource PrimaryBrush}"
                                                    BorderThickness="0"
                                                    Click="BtnEditRowPhoto_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditableImage}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Status Transfer" Width="185">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="Medium">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusCategory}" Value="Processing">
                                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusCategory}" Value="Done">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusCategory}" Value="Error">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM ACTION & PROGRESS FOOTER (COMPACT) -->
        <Border Grid.Row="2" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Grid Margin="0,0,0,5">
                        <TextBlock x:Name="TxtLog" Text="Siap. Hubungkan kamera Anda atau klik 'Folder Lokal' untuk mulai." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="TxtProgressPercent" Text="" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar x:Name="ProgressTotal" Height="6" Minimum="0" Maximum="100" Value="0" Background="{DynamicResource BgPrimaryBrush}" Foreground="{DynamicResource PrimaryBrush}" BorderThickness="0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnOpenOutputFolder" Content="Buka Folder Hasil" Height="34" Style="{StaticResource SecondaryButtonStyle}" Padding="12,0" Margin="0,0,8,0" Click="BtnOpenOutputFolder_Click"/>
                    <Button x:Name="BtnStartProcess" Content="Mulai Sortir, Edit &amp; Upload" Height="34" Style="{StaticResource SuccessButtonStyle}" Padding="16,0" FontSize="12.5" Click="BtnStartProcess_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>